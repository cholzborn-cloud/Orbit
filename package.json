{
  "name": "Orbit",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\" \"brain-server/**/*.test.ts\" && TSX_TSCONFIG_PATH=service/tsconfig.json node --import tsx --test \"service/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "service": "tsx --tsconfig service/tsconfig.json service/src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/mcp": "^2.0.74",
    "@ai-sdk/openai": "^4.0.93",
    "@daytona/sdk": "^0.224.1",
    "@hono/node-server": "^2.1.5",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.139",
    "better-sqlite3": "^13.0.3",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
